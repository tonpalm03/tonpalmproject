# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/functions/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js & export builds
/.next/
/out/
/build/

# misc
.DS_Store
*.pem

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*-debug.log
*-debug.*.log
*.log

# env files
.env*
!.env.example

# vercel & firebase
.vercel
/.firebase/

# typescript
*.tsbuildinfo
next-env.d.ts

# Local security backups & test artifacts
/security-backups/
/sales-backups/
security-migration.json
security-test-output.log

# Android & Capacitor build artifacts / large binaries
*.apk
*.aab
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/build/
android/local.properties
android/.idea/
android/*.iml
android/app/*.iml

# temp & outputs
output/
tmp/
