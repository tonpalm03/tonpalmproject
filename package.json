{
  "name": "tonpalmproject",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:android": "next build && npx cap sync android",
    "open:android": "npx cap open android",
    "test:security": "firebase emulators:exec --config firebase.emulators.json --project demo-huaychan-security --only firestore,auth \"node --test --test-concurrency=1 tests/firestore.rules.test.mjs tests/security-backend.test.cjs\"",
    "test:functions": "node --test functions/badge.test.cjs functions/line-identity.test.cjs functions/complete-order.test.cjs functions/checkout.test.cjs",
    "test:sales": "node --test tests/sales-summary.test.mjs",
    "test:readiness": "firebase emulators:exec --config firebase.emulators.json --project demo-huaychan-security --only firestore \"node --test --test-concurrency=1 tests/launch-readiness.test.mjs\"",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:hosting": "next build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/status-bar": "^8.0.3",
    "@line/liff": "^2.31.0",
    "@types/leaflet": "^1.9.22",
    "firebase": "^12.19.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
